    package executable.sfc.statement {
        class Statement {
        }
        
        class Block extends Statement {
        }
        
        class BlockSequential extends Block {
        }
        
        class BlockParallel extends Block {
        }
            
        class BlockAlternative extends Block {
        }
            
        class StatementGoal extends Statement {
        }
    
        class StatementRequirement extends Statement {
        }
    
        class StatementAction extends Statement {
        }
    }
    
    package executable.structuredtext.statement {
        class Statement {
            -- Properties --
            Integer : LineNumber
        }
        
        class Block  extends Statement {
            
        }
    }
        
    }
}
