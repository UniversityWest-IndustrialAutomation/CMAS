@startuml inline_umlgraph_15.png
json "<b>Buffer:Resource" as JBuffer {
   "Name":"Buffer",
   "Interfaces": [{"1":{ "Name":"BufferInterface",
                        "SpecialisationName":"Location",
                    "Skills": [
                        {"1":{"Name":"pickBuffer", "PostAction":"DETACHED"}}, 
                        {"2":{"Name":"placeBuffer", "PostAction":"ATTACHED"}}
                        ],
                    "Specialisation":[
                            {"Location":[{"Name":"Position"}, {"ValueType":"Integer"}, {"Value":"1"}, {"ReadOnly":"true"}]}
                                    ]
                 }}]

}

json "<b>Machine:Resource" as JMachine {
   "Name":"Machine",
   "Interfaces": {"1":[{ "Name":"ProcessInterface", 
                    "SpecialisationName":"Location",
                    "Skills": [
                    {"1":{"Name":"placeProcess", "PostAction":"ATTACHED"}}, 
                    {"2":{"Name":"runProcess",
                      "Requirements":[{"1":{"Name":"MustBeAttached", "WorkFlowType":"ATTACHED"}}]
                      }}],
                    "Specialisation":[
                       {"Location":[{"Name":"Position"}, {"ValueType":"Integer"}, {"Value":"2"}, {"ReadOnly":"true"}]}
                                    ]
                 }]}
}


json "<b>Robot:Resource" as JRobot {
   "Name":"Robot",
   "Interfaces": [{"1":{ "Name":"GripperInterface", 
                    "SpecialisationName":"Transport",
                    "Skills": {"1":{"Name":"Transport", "PostAction":"TRANSFERED"}},
                    "Specialisation":[
                                        {"1":{"FromLocation":[{"Name":"Position"}, {"ValueType":"Integer"}], "ValueType":"Object"}},                                            
                                        {"2":{"ToLocation":[{"Name":"Position"}, {"ValueType":"Integer"}], "ValueType":"Object"}},
                                        {"3":{"Step":[{"Name":"Position"}, {"ValueType":"Integer"}]}}
                                        ]
                 }}]

}

json "<b>ProductA:Part" as JProductA {
   "Name":"ProductA",
   "Goals": [
        {"1":{"Name":"GoalGetProcessed", "ProcessPlan":"runProcess", "Interface":"ProcessInterface"}}],
   "Interfaces": [
        {"1":{"Name":"BufferInterface"}}, 
        {"2":{"Name":"GripperInterface"}}
   ]
}
